<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0 -->
<interface>
  <!-- interface-name new-game.ui -->
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.4"/>
  <template class="EndGameDialog" parent="AdwApplicationWindow">
    <child>
      <object class="AdwToolbarView">
        <child>
          <object class="GtkBox">
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkBox">
                    <property name="vexpand">True</property>
                    <property name="vexpand-set">True</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">player 2 scope:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="player2_count"/>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="vexpand">True</property>
                    <property name="vexpand-set">True</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">player 1 scope: </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="player1_count"/>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkScrolledWindow" id="player2_cards_window">
                    <property name="has-frame">true</property>
                    <property name="height-request">340</property>
                    <property name="width-request">340</property>
                    <child>
                      <object class="GtkListView" id="player2_listview">
                        <property name="show-column-separators">true</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="player1_cards_window">
                    <property name="has-frame">true</property>
                    <property name="height-request">340</property>
                    <property name="width-request">340</property>
                    <child>
                      <object class="GtkListView" id="player1_listview">
                        <property name="show-column-separators">true</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
