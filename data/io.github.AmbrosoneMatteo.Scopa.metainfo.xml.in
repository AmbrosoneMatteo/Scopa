<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.AmbrosoneMatteo.Scopa</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Scopa</name>
  <summary>the classic italian card game</summary>
  <description>
    <p>Scopa is an italian card game where to win, each player has to get more
      points as possible. The available points are for: the most cards, the most
      'Ori' (a suit), the 'Settebello' (the seven of 'Ori'), and 'Scope'. Each
      Scopa is a point, a player earns a Scopa when he clears the table of cards.
      To grab a card from the table, a player needs to put down a card with the
      same value of the card he wants to take, or the sum of 2 or more cards.
    </p>
  </description>

  <developer id="tld.vendor">
    <name>Developer name</name>
  </developer>

  <!-- Required: Should be a link to the upstream homepage for the component -->
  <url type="homepage">https://github.com/AmbrosoneMatteo/Scopa</url>
  <!-- Should point to the software's bug tracking system, for users to report new bugs -->
  <url type="bugtracker">https://github.com/AmbrosoneMatteo/Scopa/issues</url>

  <translation type="gettext">scopa</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">io.github.AmbrosoneMatteo.Scopa.desktop</launchable>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and make sure to use oars-1.1 -->
  <content_rating type="oars-1.1" />

  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#ff00ff</color>
    <color type="primary" scheme_preference="dark">#993d3d</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://github.com/AmbrosoneMatteo/Scopa/blob/main/docs/images/image1.png?raw=true</image>
      <caption>A normal game</caption>
    </screenshot>
    <screenshot>
      <image>https://github.com/AmbrosoneMatteo/Scopa/blob/main/docs/images/image2.png?raw=true</image>
      <caption>A normal game</caption>
    </screenshot>
    <screenshot>
      <image>https://github.com/AmbrosoneMatteo/Scopa/blob/main/docs/images/image3.png?raw=true</image>
      <caption>endgame dialog</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.0" date="2026-07-26">
      <url type="details">https://github.com/AmbrosoneMatteo/Scopa/releases/latest</url>
      <description translate="no">
        <p>First official release</p>
      </description>
    </release>
  </releases>

</component>
